rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function perfilRef() {
      return /databases/$(database)/documents/personal/$(request.auth.uid);
    }

    function tienePerfil() {
      return signedIn() && exists(perfilRef());
    }

    function perfil() {
      return get(perfilRef()).data;
    }

    function admin() {
      return tienePerfil()
        && perfil().rol == 'Administrador'
        && perfil().estado == 'Activo';
    }

    function abogado() {
      return tienePerfil()
        && perfil().rol == 'Abogado'
        && perfil().estado == 'Activo';
    }

    function demoActual() {
      return resource.data.esDemo == true;
    }

    function esClientePropietario(datosCliente) {
      return signedIn() && datosCliente.authUid == request.auth.uid;
    }

    function esAsuntoDelCliente(datosAsunto) {
      return signedIn()
        && datosAsunto.clienteId is string
        && exists(/databases/$(database)/documents/clientes/$(datosAsunto.clienteId))
        && get(/databases/$(database)/documents/clientes/$(datosAsunto.clienteId)).data.authUid == request.auth.uid;
    }

    function asignadoAlAbogado(datos) {
      return abogado() && (
        datos.abogadoAsignado == request.auth.uid ||
        datos.abogadoAsignado == perfil().usuario ||
        datos.abogadoUid == request.auth.uid
      );
    }

    // COMPATIBILIDAD TEMPORAL DE INICIO DE SESIÓN:
    // auth.js busca el usuario/correo antes de autenticarlo.
    // En la versión comercial debe sustituirse por una colección pública mínima
    // de accesos o por inicio de sesión directo con correo.
    match /personal/{uid} {
      allow read: if !signedIn() || admin() || request.auth.uid == uid;
      allow create, update: if admin() || (!exists(/databases/$(database)/documents/personal/$(uid)) && request.auth.uid == uid);
      allow delete: if admin() && demoActual();
    }

    match /clientes/{id} {
      // Compatibilidad temporal con el portal actual, que todavía localiza
      // al cliente por usuario/correo antes de autenticarlo.
      allow read: if !signedIn() || admin() || abogado() || esClientePropietario(resource.data);
      allow create: if admin() || abogado();
      allow update: if admin() || asignadoAlAbogado(resource.data);
      allow delete: if admin() && demoActual();
    }

    match /asuntos/{id} {
      allow read: if admin() || abogado() || esAsuntoDelCliente(resource.data);
      allow create: if admin() || abogado();
      allow update: if admin() || asignadoAlAbogado(resource.data);
      allow delete: if admin() && demoActual();
    }

match /agenda/{id} {
  allow read: if admin() || abogado() || esAsuntoDelCliente(resource.data);
  allow create: if admin() || abogado();
  allow update: if admin() || asignadoAlAbogado(resource.data);
  allow delete: if admin() || asignadoAlAbogado(resource.data);
}

    match /alertas/{id} {
      allow read, create, update: if admin() || abogado();
      allow delete: if admin() && demoActual();
    }

    match /notificaciones/{id} {
      allow read, create, update: if admin() || abogado();
      allow delete: if admin() && demoActual();
    }

    match /configuracion/{id} {
      allow read, create, update: if admin() || abogado();
      allow delete: if false;
    }

    // Todo lo no definido queda bloqueado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
