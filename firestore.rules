rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function perfil() { return get(/databases/$(database)/documents/personal/$(request.auth.uid)).data; }
    function admin() { return signedIn() && perfil().rol == 'Administrador' && perfil().estado == 'Activo'; }
    function abogado() { return signedIn() && perfil().rol == 'Abogado' && perfil().estado == 'Activo'; }
    function propio(registro) {
      return registro.abogadoAsignado == request.auth.uid || registro.abogadoAsignado == perfil().usuario;
    }

    match /personal/{uid} {
      allow read: if admin() || (signedIn() && request.auth.uid == uid);
      allow create, update: if admin();
      allow delete: if false;
    }
    match /clientes/{id} {
      allow read: if admin() || (abogado() && propio(resource.data));
      allow create: if admin() || abogado();
      allow update: if admin() || (abogado() && propio(resource.data));
      allow delete: if admin();
    }
    match /asuntos/{id} {
      allow read: if admin() || (abogado() && propio(resource.data));
      allow create: if admin() || abogado();
      allow update: if admin() || (abogado() && propio(resource.data));
      allow delete: if admin();
    }
    match /agenda/{id} {
      allow read: if admin() || (abogado() && propio(resource.data));
      allow create: if admin() || abogado();
      allow update: if admin() || (abogado() && propio(resource.data));
      allow delete: if admin();
    }
  }
}
