rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function perfilPath() { return /databases/$(database)/documents/personal/$(request.auth.uid); }
    function tienePerfil() { return signedIn() && exists(perfilPath()); }
    function perfil() { return get(perfilPath()).data; }
    function activo() { return tienePerfil() && perfil().estado == 'Activo'; }

    function superadmin() { return activo() && perfil().rol == 'Superadministrador'; }
    function admin() { return activo() && perfil().rol == 'Administrador'; }
    function auxiliar() { return activo() && perfil().rol == 'Auxiliar Jurídico'; }
    function abogado() { return activo() && perfil().rol == 'Abogado'; }
    function pasante() { return activo() && perfil().rol == 'Pasante'; }
    function gestionTotal() { return superadmin() || admin(); }
    function operacionGeneral() { return gestionTotal() || auxiliar(); }

    function responsableUsuario() {
      return abogado() ? perfil().usuario :
        (pasante() && perfil().abogadoSupervisorUsuario is string
          ? perfil().abogadoSupervisorUsuario : '');
    }

    function asignado(datos) {
      return (abogado() || pasante()) && (
        datos.abogadoAsignado == responsableUsuario() ||
        (datos.colaboradorIds is list && datos.colaboradorIds.hasAny([request.auth.uid, perfil().usuario, request.auth.token.email])) ||
        datos.abogadoUid == request.auth.uid ||
        (pasante() && datos.abogadoUid == perfil().abogadoSupervisorUid)
      );
    }

    function clientePropietario(datosCliente) {
      return signedIn() && (
        datosCliente.authUid == request.auth.uid ||
        (request.auth.token.email != null && datosCliente.correo == request.auth.token.email)
      );
    }

    function asuntoDelCliente(datosAsunto) {
      return signedIn()
        && datosAsunto.clienteId is string
        && exists(/databases/$(database)/documents/clientes/$(datosAsunto.clienteId))
        && clientePropietario(get(/databases/$(database)/documents/clientes/$(datosAsunto.clienteId)).data);
    }

    match /personal/{uid} {
      allow read: if operacionGeneral() || request.auth.uid == uid;
      // Las altas se realizan exclusivamente mediante Cloud Functions con Admin SDK.
      allow create: if false;
      allow update: if gestionTotal() || (
        request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'debeCambiarPassword','ultimoCambioPassword','fechaModificacion'
        ])
        && request.resource.data.rol == resource.data.rol
        && request.resource.data.estado == resource.data.estado
      ) || (
        auxiliar()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'nombre','correo','usuario','usuarioNormalizado','abogadoSupervisorUid',
          'abogadoSupervisorUsuario','fechaModificacion'
        ])
        && request.resource.data.rol == resource.data.rol
      );
      allow delete: if false;
    }

    match /clientes/{id} {
      allow read: if operacionGeneral() || asignado(resource.data) || clientePropietario(resource.data);
      allow create: if operacionGeneral() || (
        (abogado() || pasante()) && request.resource.data.abogadoAsignado == responsableUsuario()
      );
      allow update: if gestionTotal() || (
        auxiliar() && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['nombre','curp','telefono','correo','direccion','abogadoAsignado','fechaActualizacion'])
      ) || (
        asignado(resource.data)
        && (abogado() || request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['nombre','curp','telefono','correo','direccion','fechaActualizacion']))
      ) || (
        clientePropietario(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'authUid','debeCambiarPassword','ultimoCambioPassword','fechaActualizacion'
        ])
        && request.resource.data.authUid == request.auth.uid
      );
      allow delete: if false;
    }

    match /asuntos/{id} {
      allow read: if operacionGeneral() || asignado(resource.data) || asuntoDelCliente(resource.data);
      allow create: if operacionGeneral() || (
        (abogado() || pasante()) && request.resource.data.abogadoAsignado == responsableUsuario()
      );
      allow update: if gestionTotal() || auxiliar() || asignado(resource.data);
      allow delete: if false;
    }

    match /agenda/{id} {
      allow read: if operacionGeneral() || asignado(resource.data) || asuntoDelCliente(resource.data);
      allow create: if operacionGeneral() || (
        (abogado() || pasante()) && request.resource.data.abogadoAsignado == responsableUsuario()
      );
      allow update: if operacionGeneral() || asignado(resource.data);
      allow delete: if gestionTotal() || asignado(resource.data);
    }

    match /alertas/{id} {
      allow read, create, update: if operacionGeneral() || abogado() || pasante();
      allow delete: if gestionTotal();
    }

    match /notificaciones/{id} {
      allow read, create, update: if operacionGeneral() || abogado() || pasante();
      allow delete: if gestionTotal();
    }

    match /mensajes/{id} {
      allow read: if gestionTotal()
        || (auxiliar() && resource.data.destinatarioTipo == 'Administracion')
        || (abogado() && resource.data.abogadoAsignado == perfil().usuario)
        || (signedIn() && resource.data.clienteUid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.clienteUid == request.auth.uid
        && request.resource.data.estado == 'Pendiente';
      allow update: if gestionTotal()
        || (auxiliar()
          && resource.data.destinatarioTipo == 'Administracion'
          && request.resource.data.destinatarioTipo == resource.data.destinatarioTipo
          && request.resource.data.abogadoAsignado == resource.data.abogadoAsignado)
        || (abogado()
          && resource.data.abogadoAsignado == perfil().usuario
          && request.resource.data.abogadoAsignado == resource.data.abogadoAsignado
          && request.resource.data.abogadoUid == resource.data.abogadoUid
          && request.resource.data.clienteUid == resource.data.clienteUid
          && request.resource.data.clienteId == resource.data.clienteId);
      allow delete: if false;
    }

    match /solicitudesCitas/{id} {
      allow read: if gestionTotal()
        || (auxiliar() && resource.data.destinatarioTipo == 'Administracion')
        || (abogado() && resource.data.abogadoAsignado == perfil().usuario)
        || (signedIn() && resource.data.clienteUid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.clienteUid == request.auth.uid
        && request.resource.data.estado == 'Pendiente';
      allow update: if gestionTotal()
        || (auxiliar()
          && resource.data.destinatarioTipo == 'Administracion'
          && request.resource.data.destinatarioTipo == resource.data.destinatarioTipo
          && request.resource.data.abogadoAsignado == resource.data.abogadoAsignado)
        || (abogado()
          && resource.data.abogadoAsignado == perfil().usuario
          && request.resource.data.abogadoAsignado == resource.data.abogadoAsignado
          && request.resource.data.abogadoUid == resource.data.abogadoUid
          && request.resource.data.clienteUid == resource.data.clienteUid
          && request.resource.data.clienteId == resource.data.clienteId);
      allow delete: if false;
    }

    match /configuracion/{id} {
      allow read: if activo();
      allow create, update: if gestionTotal();
      allow delete: if false;
    }

    match /auditoriaSistema/{id} {
      allow read, create: if superadmin();
      allow update, delete: if false;
    }

    match /{document=**} { allow read, write: if false; }
  }
}
