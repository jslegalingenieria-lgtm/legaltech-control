rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function autenticado() {
      return request.auth != null;
    }

    function perfilPath() {
      return /databases/(default)/documents/personal/$(request.auth.uid);
    }

    function esPersonalActivo() {
      return autenticado()
        && firestore.exists(perfilPath())
        && firestore.get(perfilPath()).data.estado == 'Activo';
    }

    function rol() {
      return esPersonalActivo()
        ? firestore.get(perfilPath()).data.rol
        : '';
    }

    function usuarioInterno() {
      return esPersonalActivo()
        && rol() in [
          'Superadministrador',
          'Administrador',
          'Auxiliar Jurídico',
          'Abogado',
          'Pasante'
        ];
    }

    function administrador() {
      return esPersonalActivo()
        && rol() in ['Superadministrador', 'Administrador'];
    }

    function tipoPermitido() {
      return request.resource.contentType in [
        'application/pdf',
        'image/jpeg',
        'image/png'
      ];
    }

    match /expedientes/{asuntoId}/{allPaths=**} {
      allow read: if usuarioInterno();

      allow create: if usuarioInterno()
        && request.resource.size <= 10 * 1024 * 1024
        && tipoPermitido();

      allow update: if false;

      allow delete: if administrador();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
